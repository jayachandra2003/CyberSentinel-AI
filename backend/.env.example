# Backend Environment Configuration
PROJECT_NAME="CyberSentinel AI API Gateway"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybersentinel
POSTGRES_PASSWORD=cybersentinel_secure_pass_2026
POSTGRES_DB=cybersentinel_db
DATABASE_URL=postgresql+asyncpg://cybersentinel:cybersentinel_secure_pass_2026@localhost:5432/cybersentinel_db

# Redis & Celery Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
SECRET_KEY=super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
